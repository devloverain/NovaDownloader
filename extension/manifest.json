{
  "manifest_version": 3,
  "name": "NovaDownloader - Media & Stream Downloader",
  "version": "1.2.0",
  "key": "",
  "description": "Ultra-fast video, audio, and file download accelerator with native NovaDownloader desktop integration.",
  "permissions": [
    "webRequest",
    "declarativeNetRequest",
    "downloads",
    "nativeMessaging",
    "storage",
    "activeTab",
    "scripting",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "NovaDownloader",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
