<Window x:Class="NovaDownloader.UI.Dialogs.BatchDownloadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:NovaDownloader.UI.Converters"
        Title="Download Selected Links"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="840" Height="540" MinWidth="700" MinHeight="430"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#14161D" Foreground="#F1F5F9" FontFamily="Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:FileIconConverter x:Key="FileIconConverter"/>

        <Style x:Key="BatchInput" TargetType="TextBox">
            <Setter Property="Background" Value="#1B1E28"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="CaretBrush" Value="#22D3EE"/>
            <Setter Property="BorderBrush" Value="#2E3342"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="BatchBtn" TargetType="Button">
            <Setter Property="Background" Value="#242836"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#353A4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#1B1F2A"/>
                                <Setter Property="Foreground" Value="#5A657A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BatchPrimaryBtn" TargetType="Button" BasedOn="{StaticResource BatchBtn}">
            <Setter Property="Background" Value="#0891B2"/>
            <Setter Property="BorderBrush" Value="#22D3EE"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#2B2E3B" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" Background="#14161D">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="pack://application:,,,/Assets/Icons/app_logo.png" Width="16" Height="16"
                       RenderOptions.BitmapScalingMode="HighQuality" Margin="10,0,8,0"/>
                <TextBlock Grid.Column="1" Text="Download Selected Links" FontSize="12.5" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                <Border Grid.Column="2" Background="#162436" BorderBrush="#22D3EE" BorderThickness="1" CornerRadius="4"
                        Padding="7,1" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock x:Name="SelectionBadgeText" Text="0 Selected" FontSize="10.5" FontWeight="Bold" Foreground="#22D3EE"/>
                </Border>
                <TextBlock x:Name="ProbeStatusText" Grid.Column="3" Text="Checking file sizes..." FontSize="11" Foreground="#94A3B8"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Grid.Column="4" Content="✕" Click="CancelButton_Click" Style="{StaticResource CloseCaptionButtonStyle}" Height="32" Width="38"/>
            </Grid>

            <!-- Smart Filter Toolbar -->
            <Border Grid.Row="1" Background="#181B24" BorderBrush="#262B38" BorderThickness="0,1,0,1" Padding="14,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="FilterSearchBox" Grid.Column="0" Style="{StaticResource BatchInput}" Height="27"
                             TextChanged="FilterChanged" ToolTip="Filter links by file name or link text"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <CheckBox x:Name="HideWebpagesCheckBox" Content="Hide webpages (.html)" IsChecked="True"
                                  Foreground="#CBD5E1" FontSize="12" Margin="0,0,14,0" Checked="FilterChanged" Unchecked="FilterChanged"/>
                        <CheckBox x:Name="HideImagesCheckBox" Content="Hide images" IsChecked="True"
                                  Foreground="#CBD5E1" FontSize="12" Margin="0,0,14,0" Checked="FilterChanged" Unchecked="FilterChanged"/>
                        <CheckBox x:Name="HideDuplicatesCheckBox" Content="Hide duplicates" IsChecked="True"
                                  Foreground="#CBD5E1" FontSize="12" Checked="FilterChanged" Unchecked="FilterChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="Check All" Style="{StaticResource BatchBtn}" Padding="9,4" FontSize="11.5" Margin="0,0,6,0" Click="CheckAll_Click"/>
                        <Button Content="Uncheck All" Style="{StaticResource BatchBtn}" Padding="9,4" FontSize="11.5" Click="UncheckAll_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Links DataGrid -->
            <DataGrid x:Name="LinksGrid" Grid.Row="2"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      AlternationCount="2"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#262936"
                      HeadersVisibility="Column"
                      Background="#1A1C24"
                      BorderThickness="0"
                      RowHeight="32"
                      ColumnHeaderStyle="{StaticResource IdmColumnHeaderStyle}"
                      RowStyle="{StaticResource IdmDataGridRowStyle}"
                      CellStyle="{StaticResource IdmDataGridCellStyle}">
                <DataGrid.Columns>
                    <!-- Checkbox -->
                    <DataGridTemplateColumn Header="✓" Width="40">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Checked="ItemCheckChanged" Unchecked="ItemCheckChanged"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- File Name + Icon -->
                    <DataGridTemplateColumn Header="File Name" Width="245" SortMemberPath="FileName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="{Binding FileName, Converter={StaticResource FileIconConverter}}"
                                           Width="16" Height="16" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                               Foreground="#F8FAFC" FontWeight="Medium" ToolTip="{Binding Url}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Type Pill -->
                    <DataGridTemplateColumn Header="Type" Width="72" SortMemberPath="Extension">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#132235" BorderBrush="#1E3A5F" BorderThickness="1" CornerRadius="4"
                                        Padding="6,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Extension}" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Probed Size -->
                    <DataGridTextColumn Header="Size" Binding="{Binding FormattedSize}" Width="88" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
                                <Setter Property="Typography.NumeralStyle" Value="Lining"/>
                                <Setter Property="Foreground" Value="#34D399"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Link Text / Note -->
                    <DataGridTextColumn Header="Link Text" Binding="{Binding LinkText}" Width="145" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="Foreground" Value="#CBD5E1"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Save To -->
                    <DataGridTextColumn Header="Save To" Binding="{Binding DestinationPath}" Width="*" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="ToolTip" Value="{Binding DestinationPath}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Destination & Schedule Options -->
            <Border Grid.Row="3" Background="#181B24" BorderBrush="#262B38" BorderThickness="0,1,0,0" Padding="14,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Save Mode + Folder -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Save To:" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <RadioButton x:Name="SaveByCategoryRadio" Grid.Column="1" Content="Auto-organize by Category" IsChecked="True"
                                     Foreground="#E2E8F0" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0"
                                     Checked="SaveModeChanged"/>
                        <RadioButton x:Name="SaveSingleFolderRadio" Grid.Column="2" Content="One Folder:"
                                     Foreground="#E2E8F0" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"
                                     Checked="SaveModeChanged"/>
                        <TextBox x:Name="CustomFolderBox" Grid.Column="3" Style="{StaticResource BatchInput}" Height="26" IsEnabled="False"/>
                        <Button x:Name="BrowseFolderBtn" Grid.Column="4" Content="Browse..." Style="{StaticResource BatchBtn}"
                                Height="26" Padding="10,2" Margin="6,0,0,0" IsEnabled="False" Click="BrowseFolder_Click"/>
                    </Grid>

                    <!-- Row 2: Schedule + Link Text option -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Schedule / Queue:" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox x:Name="QueueComboBox" Grid.Column="1" Height="27" DisplayMemberPath="Name"/>
                        <Button Grid.Column="2" Content="+" Style="{StaticResource BatchBtn}" Height="27" Width="28" Padding="0"
                                Margin="5,0,16,0" ToolTip="Create new schedule (e.g. Games)" Click="QuickCreateQueue_Click"/>

                        <CheckBox x:Name="UseLinkTextDescCheckBox" Grid.Column="3" Content="Use link text as Download Note" IsChecked="True"
                                  Foreground="#CBD5E1" FontSize="12" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Footer -->
            <Border Grid.Row="4" Background="#14161D" BorderBrush="#262B38" BorderThickness="0,1,0,0" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Add to Schedule" Style="{StaticResource BatchBtn}"
                            MinWidth="126" Click="AddToSchedule_Click"
                            ToolTip="Add checked files to the selected schedule/queue without starting immediately"/>

                    <Button x:Name="DownloadSelectedBtn" Grid.Column="2" Content="Download Selected (0)" Style="{StaticResource BatchPrimaryBtn}"
                            MinWidth="165" Margin="0,0,8,0" Click="DownloadSelected_Click" IsDefault="True"/>

                    <Button Grid.Column="3" Content="Cancel" Style="{StaticResource BatchBtn}"
                            MinWidth="80" Click="CancelButton_Click" IsCancel="True"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
