<Window x:Class="NovaDownloader.UI.Dialogs.BrowserIntegrationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Browser Integration Setup"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#14161D" Foreground="#F1F5F9" FontFamily="Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="DialogBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#252834"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#353846"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#323646"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentBtnStyle" TargetType="Button" BasedOn="{StaticResource DialogBtnStyle}">
            <Setter Property="Background" Value="#0891B2"/>
            <Setter Property="BorderBrush" Value="#22D3EE"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0E7490"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#2B2E3B" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Custom Dark Title Bar -->
            <Grid Grid.Row="0" Background="#14161D">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                    <Image Source="pack://application:,,,/Assets/Icons/app_logo.png" Width="16" Height="16" Margin="0,0,8,0"/>
                    <TextBlock Text="Easy Browser Extension Setup" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Click="Close_Click" Style="{StaticResource CloseCaptionButtonStyle}" Width="40" Height="32"/>
            </Grid>

            <!-- Content -->
            <StackPanel Grid.Row="1" Margin="18,14,18,16">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Image Source="pack://application:,,,/Assets/Icons/cat_grabber.png" Width="30" Height="30" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Install Browser Extension" FontSize="15.5" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <TextBlock Text="Native Host is auto-registered — pick your browser below to install." FontSize="12" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>

                <!-- Compact Status Strip -->
                <Border Background="#181B24" BorderBrush="#262B38" BorderThickness="1" CornerRadius="7" Padding="12,9" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Native Host &amp; Registry" FontSize="11" Foreground="#64748B"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock x:Name="HostStatusText" Text="Ready" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text=" • " Foreground="#475569" FontSize="12"/>
                                <TextBlock x:Name="RegistryStatusText" Text="Registered" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Detected Browsers" FontSize="11" Foreground="#64748B"/>
                            <TextBlock x:Name="DetectedBrowsersText" Text="Checking..." Foreground="#38BDF8" FontWeight="SemiBold" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 1-Click Browser Install Buttons -->
                <Border Background="#181B24" BorderBrush="#262B38" BorderThickness="1" CornerRadius="7" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="1. Choose your browser (automatically copies extension path &amp; opens Extensions page):"
                                   FontWeight="SemiBold" FontSize="12" Foreground="#F1F5F9" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Install in Chrome" Style="{StaticResource AccentBtnStyle}" Click="OpenChrome_Click"/>
                            <Button Grid.Column="2" Content="Install in Edge" Style="{StaticResource AccentBtnStyle}" Click="OpenEdge_Click"/>
                            <Button Grid.Column="4" Content="Install in Opera" Style="{StaticResource AccentBtnStyle}" Click="OpenOpera_Click"/>
                        </Grid>

                        <Border Background="#13161E" BorderBrush="#262B38" BorderThickness="1" CornerRadius="6" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="2. In the browser window that opens:" FontSize="11.5" FontWeight="SemiBold" Foreground="#22D3EE" Margin="0,0,0,4"/>
                                <TextBlock Text="• Turn ON  Developer mode  (top-right switch)" FontSize="11.5" Foreground="#CBD5E1"/>
                                <TextBlock Text="• Click  Load unpacked  (top-left button)" FontSize="11.5" Foreground="#CBD5E1" Margin="0,2,0,0"/>
                                <TextBlock Text="• Press  Ctrl + V  in the folder box and click  Select Folder" FontSize="11.5" Foreground="#CBD5E1" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Secondary Tools -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Copy Path" Style="{StaticResource DialogBtnStyle}" Padding="10,5" Margin="0,0,6,0" Click="CopyPath_Click"/>
                    <Button Grid.Column="1" Content="Open Folder" Style="{StaticResource DialogBtnStyle}" Padding="10,5" Margin="0,0,6,0" Click="OpenFolder_Click"/>
                    <Button Grid.Column="2" Content="Launch Chrome (Quick)" Style="{StaticResource DialogBtnStyle}" Padding="10,5" Click="LaunchChromeWithExt_Click"
                            ToolTip="Relaunch Chrome with NovaDownloader extension loaded directly"/>
                    <Button Grid.Column="4" Content="Done" Style="{StaticResource AccentBtnStyle}" MinWidth="80" Padding="12,5" Click="Close_Click"/>
                </Grid>

                <TextBlock x:Name="FeedbackText" Text="" FontSize="11.5" Foreground="#4ADE80" Margin="0,8,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="ExtensionPathText" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
