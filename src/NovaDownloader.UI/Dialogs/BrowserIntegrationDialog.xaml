<Window x:Class="NovaDownloader.UI.Dialogs.BrowserIntegrationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Browser Integration Setup"
        Width="640" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#14161D" Foreground="#F1F5F9" FontFamily="Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="DialogBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#252834"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#353846"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#323646"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentBtnStyle" TargetType="Button" BasedOn="{StaticResource DialogBtnStyle}">
            <Setter Property="Background" Value="#0891B2"/>
            <Setter Property="BorderBrush" Value="#22D3EE"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0E7490"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#2B2E3B" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Custom Dark Title Bar -->
            <Grid Grid.Row="0" Background="#14161D">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                    <Image Source="pack://application:,,,/Assets/Icons/app_logo.png" Width="16" Height="16" Margin="0,0,8,0"/>
                    <TextBlock Text="Browser Integration Setup" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Click="Close_Click" Style="{StaticResource CloseCaptionButtonStyle}" Width="40" Height="32"/>
            </Grid>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="20,14,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                    <Image Source="pack://application:,,,/Assets/Icons/cat_grabber.png" Width="32" Height="32" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Browser Extension &amp; Native Host Setup" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <TextBlock Text="Connect Chrome, Edge, Opera, Brave, or Vivaldi to NovaDownloader" FontSize="12" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>

                <!-- Status Card -->
                <Border Grid.Row="1" Background="#1E1E24" BorderBrush="#2B2E3B" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Native Host Binary:" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="HostStatusText" Text="Checking..." FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Registry Integration:" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="RegistryStatusText" Text="Checking..." FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Detected Browsers:" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DetectedBrowsersText" Text="Checking..." Foreground="#38BDF8" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Extension Folder:" Foreground="#94A3B8" FontSize="12"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ExtensionPathText" Text="Checking..." Foreground="#CBD5E1" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>

                <!-- Step 1: Register Native Host -->
                <Border Grid.Row="2" Background="#1E1E24" BorderBrush="#2B2E3B" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Step 1: Register Native Messaging Host" FontWeight="SemiBold" FontSize="13" Foreground="#F1F5F9"/>
                            <TextBlock Text="Writes the Windows Registry keys for Chrome, Edge, Opera, Brave, and Vivaldi." FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Register Native Host" Style="{StaticResource AccentBtnStyle}" Click="RegisterHost_Click"/>
                    </Grid>
                </Border>

                <!-- Step 2: Load Extension in Browser -->
                <Border Grid.Row="3" Background="#1E1E24" BorderBrush="#2B2E3B" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Step 2: Load Extension in Your Browser" FontWeight="SemiBold" FontSize="13" Foreground="#F1F5F9" Margin="0,0,0,6"/>
                        <TextBlock Text="1. Open your browser's Extensions page and enable Developer Mode (top-right)." FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,3"/>
                        <TextBlock Text="2. Click 'Load unpacked' and paste the copied extension folder path." FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,12"/>

                        <WrapPanel Orientation="Horizontal">
                            <Button Content="Copy Extension Path" Style="{StaticResource DialogBtnStyle}" Click="CopyPath_Click" Margin="0,0,8,8"/>
                            <Button Content="Open Folder" Style="{StaticResource DialogBtnStyle}" Click="OpenFolder_Click" Margin="0,0,8,8"/>
                            <Button Content="Open Chrome Extensions" Style="{StaticResource DialogBtnStyle}" Click="OpenChrome_Click" Margin="0,0,8,8"/>
                            <Button Content="Open Opera Extensions" Style="{StaticResource DialogBtnStyle}" Click="OpenOpera_Click" Margin="0,0,8,8"/>
                            <Button Content="Open Edge Extensions" Style="{StaticResource DialogBtnStyle}" Click="OpenEdge_Click" Margin="0,0,8,8"/>
                            <Button Content="Launch Chrome with Extension" Style="{StaticResource AccentBtnStyle}" Click="LaunchChromeWithExt_Click" Margin="0,0,8,8"/>
                            <Button Content="Launch Opera with Extension" Style="{StaticResource AccentBtnStyle}" Click="LaunchOperaWithExt_Click" Margin="0,0,8,8"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Footer -->
                <Grid Grid.Row="4" Margin="0,14,0,0">
                    <TextBlock x:Name="FeedbackText" Text="" FontSize="12" Foreground="#4ADE80" VerticalAlignment="Center"/>
                    <Button Content="Close" HorizontalAlignment="Right" Style="{StaticResource DialogBtnStyle}" Width="90" Click="Close_Click"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
