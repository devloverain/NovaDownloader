<Window x:Class="NovaDownloader.UI.Dialogs.OptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NovaDownloader Options"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="710" Height="500" MinWidth="660" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        Background="#14161D" Foreground="#F1F5F9" FontFamily="Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="OptInput" TargetType="TextBox">
            <Setter Property="Background" Value="#1B1E28"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="CaretBrush" Value="#22D3EE"/>
            <Setter Property="BorderBrush" Value="#2E3342"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#22D3EE"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OptBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#242836"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#353B4E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#313649"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OptAccentBtnStyle" TargetType="Button" BasedOn="{StaticResource OptBtnStyle}">
            <Setter Property="Background" Value="#0891B2"/>
            <Setter Property="BorderBrush" Value="#22D3EE"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#06B6D4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavTabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="10,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Pill" Grid.Column="0" Width="3" Height="16" CornerRadius="2"
                                        Background="#22D3EE" Visibility="Collapsed" Margin="0,0,6,0"/>
                                <ContentPresenter Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E2230"/>
                                <Setter Property="Foreground" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1B2A3E"/>
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#181B24"/>
            <Setter Property="BorderBrush" Value="#262B38"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#2B2E3B" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Custom Dark Title Bar -->
            <Grid Grid.Row="0" Background="#14161D">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                    <Image Source="pack://application:,,,/Assets/Icons/tb_options.png" Width="16" Height="16" Margin="0,0,8,0"/>
                    <TextBlock Text="NovaDownloader Options" FontSize="12.5" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Click="Cancel_Click" Style="{StaticResource CloseCaptionButtonStyle}" Width="40" Height="32"/>
            </Grid>

            <!-- Two-Pane Tabbed Body -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="178"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Navigation Sidebar -->
                <Border Grid.Column="0" Background="#161922" Padding="10,12">
                    <StackPanel>
                        <TextBlock Text="SETTINGS" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" Margin="10,0,0,8"/>
                        <RadioButton x:Name="TabGeneral" Content="⚙  General" Style="{StaticResource NavTabStyle}" IsChecked="True" Checked="NavTab_Checked"/>
                        <RadioButton x:Name="TabFolders" Content="📁  Folders &amp; Types" Style="{StaticResource NavTabStyle}" Checked="NavTab_Checked"/>
                        <RadioButton x:Name="TabNetwork" Content="⚡  Speed &amp; Network" Style="{StaticResource NavTabStyle}" Checked="NavTab_Checked"/>
                        <RadioButton x:Name="TabTools" Content="🌐  Browser &amp; Tools" Style="{StaticResource NavTabStyle}" Checked="NavTab_Checked"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#262B38"/>

                <!-- Right Content Area -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="18,14,18,8">
                    <Grid>
                        <!-- TAB 1: GENERAL & STARTUP -->
                        <StackPanel x:Name="PanelGeneral" Visibility="Visible">
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Startup &amp; Tray Behavior" Style="{StaticResource CardTitle}"/>
                                    <CheckBox x:Name="LaunchOnStartupCheckBox" Content="Launch NovaDownloader automatically when Windows starts"
                                              Margin="0,0,0,8" Checked="LaunchOnStartupCheckBox_Changed" Unchecked="LaunchOnStartupCheckBox_Changed"/>
                                    <CheckBox x:Name="StartMinimizedCheckBox" Content="Start minimized quietly in the System Tray"
                                              Margin="22,0,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Notifications &amp; Post-Download Actions" Style="{StaticResource CardTitle}"/>
                                    <CheckBox x:Name="ShowCompletedDialogCheckBox" Content="Show Finish Download dialog when a download completes" Margin="0,0,0,8"/>
                                    <CheckBox x:Name="PlaySoundCheckBox" Content="Play a notification sound when a download finishes" Margin="0,0,0,8"/>
                                    <CheckBox x:Name="AutoExtractCheckBox" Content="Automatically extract .zip archives into a subfolder after download"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Duplicate File Name" FontSize="12.5" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                        <TextBlock Text="If file already exists" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ComboBox x:Name="DuplicateBehaviorCombo" Grid.Column="1" Height="30" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- TAB 2: FOLDERS & FILE TYPES -->
                        <StackPanel x:Name="PanelFolders" Visibility="Collapsed">
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Default Root Download Folder" Style="{StaticResource CardTitle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="DefaultFolderBox" Style="{StaticResource OptInput}"/>
                                        <Button Grid.Column="1" Content="Browse..." Style="{StaticResource OptBtnStyle}" Margin="6,0,0,0" Click="BrowseRootFolder_Click"/>
                                        <Button Grid.Column="2" Content="Apply All" Style="{StaticResource OptAccentBtnStyle}" Margin="6,0,0,0"
                                                ToolTip="Set Video, Music, Compressed, Documents, and Programs subfolders under this root folder"
                                                Click="ApplyRootToCategories_Click"/>
                                    </Grid>
                                    <TextBlock Text="Tip: Click 'Apply All' to organize downloads into Video, Music, Compressed, Documents &amp; Programs folders."
                                               FontSize="11" Foreground="#64748B" Margin="0,7,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Category Folders &amp; File Extensions" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="Reset Defaults" Style="{StaticResource OptBtnStyle}" Padding="8,4" FontSize="11" Click="ResetCategoryDefaults_Click"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="115"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Category:" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" x:Name="CategorySelectCombo" Height="29" SelectionChanged="CategorySelectCombo_SelectionChanged"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="115"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Save Folder:" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="CategoryPathBox" Style="{StaticResource OptInput}" TextChanged="CategoryPathBox_TextChanged"/>
                                        <Button Grid.Column="2" Content="..." Style="{StaticResource OptBtnStyle}" Padding="10,5" Margin="6,0,0,0" Click="BrowseCategoryFolder_Click"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="115"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Extensions:" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="CategoryExtensionsBox" Style="{StaticResource OptInput}"
                                                 TextChanged="CategoryExtensionsBox_TextChanged"
                                                 ToolTip="Comma-separated extensions (e.g. .mp4, .mkv, .webm)"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- TAB 3: SPEED & NETWORK -->
                        <StackPanel x:Name="PanelNetwork" Visibility="Collapsed">
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Concurrency &amp; Multi-Segment Engine" Style="{StaticResource CardTitle}"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="185"/>
                                            <ColumnDefinition Width="85"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Max Concurrent Downloads:" Foreground="#CBD5E1" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="MaxConcurrentBox" Style="{StaticResource OptInput}"/>
                                        <TextBlock Grid.Column="2" Text="(1 – 16 files at once)" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="185"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="75"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Connections per File:" Foreground="#CBD5E1" FontSize="12" VerticalAlignment="Center"/>
                                        <Slider Grid.Column="1" x:Name="SegmentsSlider" Minimum="1" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center" ValueChanged="SegmentsSlider_ValueChanged"/>
                                        <TextBlock Grid.Column="2" x:Name="SegmentsValueText" Text="8 threads" Foreground="#22D3EE" FontWeight="SemiBold"
                                                   FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Speed Limiter (Bandwidth Cap)" Style="{StaticResource CardTitle}"/>
                                    <CheckBox x:Name="SpeedLimitCheckBox" Content="Limit maximum download speed" Margin="0,0,0,10"
                                              Checked="SpeedLimitCheckBox_Changed" Unchecked="SpeedLimitCheckBox_Changed"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="SpeedLimitBox" Style="{StaticResource OptInput}" Width="90" Text="2048"/>
                                        <TextBlock Text="KB/s" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" Margin="8,0,14,0"/>
                                        <Button Content="500 KB/s" Style="{StaticResource OptBtnStyle}" Padding="8,4" FontSize="11" Margin="0,0,5,0" Tag="500" Click="SpeedPreset_Click"/>
                                        <Button Content="2 MB/s" Style="{StaticResource OptBtnStyle}" Padding="8,4" FontSize="11" Margin="0,0,5,0" Tag="2048" Click="SpeedPreset_Click"/>
                                        <Button Content="5 MB/s" Style="{StaticResource OptBtnStyle}" Padding="8,4" FontSize="11" Margin="0,0,5,0" Tag="5120" Click="SpeedPreset_Click"/>
                                        <Button Content="10 MB/s" Style="{StaticResource OptBtnStyle}" Padding="8,4" FontSize="11" Tag="10240" Click="SpeedPreset_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Proxy &amp; Custom User-Agent" Style="{StaticResource CardTitle}"/>
                                    <CheckBox x:Name="ProxyEnabledCheckBox" Content="Use HTTP / SOCKS Proxy" Margin="0,0,0,8"
                                              Checked="ProxyCheckBox_Changed" Unchecked="ProxyCheckBox_Changed"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.6*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="ProxyAddressBox" Style="{StaticResource OptInput}" ToolTip="e.g. http://127.0.0.1:8080"/>
                                        <TextBox Grid.Column="2" x:Name="ProxyUserBox" Style="{StaticResource OptInput}" ToolTip="Username (optional)"/>
                                        <TextBox Grid.Column="4" x:Name="ProxyPassBox" Style="{StaticResource OptInput}" ToolTip="Password (optional)"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="95"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="User-Agent:" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="UserAgentBox" Style="{StaticResource OptInput}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- TAB 4: BROWSER & TOOLS -->
                        <StackPanel x:Name="PanelTools" Visibility="Collapsed">
                            <Border Style="{StaticResource CardBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="Browser Integration" FontWeight="SemiBold" FontSize="13" Foreground="#F8FAFC"/>
                                        <TextBlock Text="Manage Native Messaging Host and Chrome / Opera / Edge / Brave extension." FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Setup Extension..." Style="{StaticResource OptAccentBtnStyle}" Click="OpenBrowserIntegration_Click"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="External Media Tools (yt-dlp &amp; ffmpeg)" Style="{StaticResource CardTitle}"/>

                                    <!-- yt-dlp row -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="85"/>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="yt-dlp.exe" Foreground="#CBD5E1" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="YtDlpStatusText" Text="Checking" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="2" x:Name="YtDlpPathBox" Style="{StaticResource OptInput}"/>
                                        <Button Grid.Column="3" Content="..." Style="{StaticResource OptBtnStyle}" Padding="10,5" Margin="6,0,0,0" Click="BrowseYtDlp_Click"/>
                                        <Button Grid.Column="4" x:Name="UpdateYtDlpBtn" Content="Update" Style="{StaticResource OptAccentBtnStyle}" Padding="10,5" Margin="6,0,0,0" Click="UpdateYtDlp_Click"/>
                                    </Grid>

                                    <!-- ffmpeg row -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="85"/>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="ffmpeg.exe" Foreground="#CBD5E1" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="FfmpegStatusText" Text="Checking" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="2" x:Name="FfmpegPathBox" Style="{StaticResource OptInput}"/>
                                        <Button Grid.Column="3" Content="..." Style="{StaticResource OptBtnStyle}" Padding="10,5" Margin="6,0,0,0" Click="BrowseFfmpeg_Click"/>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="InstallToolsBtn" Content="Download Missing Tools (yt-dlp &amp; ffmpeg)"
                                                Style="{StaticResource OptAccentBtnStyle}" Padding="12,5" Click="InstallTools_Click"/>
                                    </StackPanel>

                                    <TextBlock x:Name="ToolsFeedbackText" FontSize="11" Foreground="#94A3B8" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#181A22" BorderBrush="#262B38" BorderThickness="0,1,0,0" Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Save Changes" Style="{StaticResource OptAccentBtnStyle}" MinWidth="112" Margin="0,0,8,0" Click="Save_Click" IsDefault="True"/>
                    <Button Content="Cancel" Style="{StaticResource OptBtnStyle}" MinWidth="84" Click="Cancel_Click" IsCancel="True"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
