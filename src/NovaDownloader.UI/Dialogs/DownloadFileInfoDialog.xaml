<Window x:Class="NovaDownloader.UI.Dialogs.DownloadFileInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Start Download"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="510" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#14161D" Foreground="#F1F5F9" FontFamily="Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="CompactInput" TargetType="TextBox">
            <Setter Property="Background" Value="#1B1E28"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="CaretBrush" Value="#22D3EE"/>
            <Setter Property="BorderBrush" Value="#2E3342"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#22D3EE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="#1B1E28"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#2E3342"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="#1B1E28" BorderBrush="#2E3342" BorderThickness="1" CornerRadius="5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Data="M 0 0 L 3.5 3.5 L 7 0 Z" Fill="#94A3B8"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#475569"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="9,0,24,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#1B1E28" BorderBrush="#353A4A" BorderThickness="1" CornerRadius="5"
                                        MinWidth="{TemplateBinding ActualWidth}" Margin="0,2,0,0" Padding="2">
                                    <ScrollViewer MaxHeight="160">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#E2E8F0"/>
                        <Setter Property="Padding" Value="8,5"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#2A2E3D"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#1E3A5F"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecBtn" TargetType="Button">
            <Setter Property="Background" Value="#242834"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#353A4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2F3444"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimBtn" TargetType="Button" BasedOn="{StaticResource SecBtn}">
            <Setter Property="Background" Value="#0891B2"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#22D3EE"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#06B6D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#2B2E3B" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Compact Title Bar -->
            <Grid Grid.Row="0" Background="#14161D">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                    <Image Source="pack://application:,,,/Assets/Icons/app_logo.png" Width="15" Height="15"
                           RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,7,0"/>
                    <TextBlock Text="Start New Download" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Click="CancelButton_Click" Style="{StaticResource CloseCaptionButtonStyle}" Height="30" Width="36" ToolTip="Close"/>
            </Grid>

            <!-- Compact Form Body -->
            <StackPanel Grid.Row="1" Margin="14,10,14,10">
                <!-- Header Preview Strip -->
                <Border Background="#181B24" BorderBrush="#262B38" BorderThickness="1" CornerRadius="7" Padding="10,8" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="40" Height="40" Background="#12151E" BorderBrush="#2A3040" BorderThickness="1" CornerRadius="7" Margin="0,0,10,0">
                            <Image x:Name="PreviewIcon" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="PreviewFileNameText" Text="New Download" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="MetaInfoText" Text="Ready" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="2" Background="#0F172A" BorderBrush="#22D3EE" BorderThickness="1" CornerRadius="4"
                                Padding="7,2" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock x:Name="ExtBadgeText" Text="FILE" FontSize="10" FontWeight="Bold" Foreground="#22D3EE"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Form Grid -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="66"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- URL -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="URL" Foreground="#94A3B8" VerticalAlignment="Center" FontSize="12"/>
                    <TextBox x:Name="UrlTextBox" Grid.Row="0" Grid.Column="1" Style="{StaticResource CompactInput}"
                             TextChanged="UrlTextBox_TextChanged"/>

                    <!-- Save As -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Save As" Foreground="#94A3B8" VerticalAlignment="Center" FontSize="12"/>
                    <Grid Grid.Row="1" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SaveAsTextBox" Grid.Column="0" Style="{StaticResource CompactInput}"
                                 TextChanged="SaveAsTextBox_TextChanged"/>
                        <Button Grid.Column="1" Content="..." Margin="5,0,0,0" Padding="0" Height="28" Style="{StaticResource SecBtn}"
                                ToolTip="Browse save location" Click="BrowseButton_Click"/>
                    </Grid>

                    <!-- Category & Schedule Side-by-Side -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Category" Foreground="#94A3B8" VerticalAlignment="Center" FontSize="12"/>
                    <Grid Grid.Row="2" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="CategoryComboBox" Grid.Column="0" Style="{StaticResource CompactCombo}"
                                  SelectionChanged="CategoryComboBox_SelectionChanged"/>
                        <Button Grid.Column="1" Content="📁" FontSize="11" Margin="4,0,0,0" Padding="0" Height="28" Style="{StaticResource SecBtn}"
                                ToolTip="Set folder for this category" Click="ChangeCategoryFolder_Click"/>

                        <TextBlock Grid.Column="2" Text="Schedule" Foreground="#94A3B8" VerticalAlignment="Center" FontSize="12" Margin="10,0,6,0"/>
                        <ComboBox x:Name="QueueComboBox" Grid.Column="3" Style="{StaticResource CompactCombo}" DisplayMemberPath="Name"/>
                        <Button Grid.Column="4" Content="+" FontWeight="Bold" Margin="4,0,0,0" Padding="0" Height="28" Style="{StaticResource SecBtn}"
                                ToolTip="Create a new schedule (e.g. Games)" Click="ToggleNewSchedule_Click"/>
                    </Grid>

                    <!-- Inline Quick New Schedule Creator -->
                    <Border x:Name="QuickNewSchedulePanel" Grid.Row="3" Grid.Column="1" Visibility="Collapsed"
                            Background="#181B24" BorderBrush="#2E3342" BorderThickness="1" CornerRadius="5" Padding="6" Margin="0,4,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NewScheduleNameBox" Grid.Column="0" Style="{StaticResource CompactInput}" Height="26"
                                     KeyDown="NewScheduleNameBox_KeyDown" ToolTip="Schedule name (e.g. Games)"/>
                            <Button Grid.Column="1" Content="Add" Style="{StaticResource PrimBtn}" Height="26" Padding="10,2" Margin="6,0,0,0"
                                    Click="CreateNewSchedule_Click"/>
                            <Button Grid.Column="2" Content="✕" Style="{StaticResource SecBtn}" Height="26" Padding="7,2" Margin="4,0,0,0"
                                    Click="CancelNewSchedule_Click"/>
                        </Grid>
                    </Border>

                    <!-- Note / Description -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Note" Foreground="#94A3B8" VerticalAlignment="Center" FontSize="12"/>
                    <TextBox x:Name="DescriptionTextBox" Grid.Row="4" Grid.Column="1" Style="{StaticResource CompactInput}"/>

                    <!-- Remember Category Path Checkbox -->
                    <CheckBox x:Name="RememberPathCheckBox" Grid.Row="5" Grid.Column="1" IsChecked="True"
                              Foreground="#94A3B8" FontSize="11.5" Margin="0,5,0,0"
                              Checked="RememberPathCheckBox_Changed" Unchecked="RememberPathCheckBox_Changed">
                        <TextBlock x:Name="RememberPathLabel" Text="Remember save folder for this category"/>
                    </CheckBox>
                </Grid>
            </StackPanel>

            <!-- Compact Footer -->
            <Border Grid.Row="2" Background="#181A22" BorderBrush="#262B38" BorderThickness="0,1,0,0" Padding="14,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Add to Schedule" Style="{StaticResource SecBtn}"
                            MinWidth="112" Click="DownloadLaterButton_Click"
                            ToolTip="Save to the selected schedule/queue without starting immediately"/>

                    <Button Grid.Column="2" Content="Start Download" Style="{StaticResource PrimBtn}"
                            MinWidth="116" Margin="0,0,8,0" Click="StartDownloadButton_Click" IsDefault="True"/>

                    <Button Grid.Column="3" Content="Cancel" Style="{StaticResource SecBtn}"
                            MinWidth="74" Click="CancelButton_Click" IsCancel="True"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
