<Window x:Class="NovaDownloader.UI.Dialogs.DownloadCompletedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:NovaDownloader.UI.Converters"
        Title="Download Complete"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="450" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#14161D" Foreground="#F1F5F9" FontFamily="Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:FileIconConverter x:Key="FileIconConverter"/>

        <Style x:Key="DoneBtn" TargetType="Button">
            <Setter Property="Background" Value="#242836"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#353B4E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#1B1F2A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#282D3B"/>
                                <Setter Property="Foreground" Value="#5A657A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#10B981" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" Background="#14161D">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="pack://application:,,,/Assets/Icons/app_logo.png" Width="15" Height="15"
                       RenderOptions.BitmapScalingMode="HighQuality" Margin="10,0,7,0" VerticalAlignment="Center"/>
                <Border Grid.Column="1" Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4"
                        Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="✓ COMPLETE" FontSize="9.5" FontWeight="Bold" Foreground="#34D399"/>
                </Border>
                <TextBlock Grid.Column="2" Text="Download Finished" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                <Button Grid.Column="3" Content="✕" Click="CloseButton_Click" Style="{StaticResource CloseCaptionButtonStyle}" Height="30" Width="36"/>
            </Grid>

            <!-- Body -->
            <StackPanel Grid.Row="1" Margin="14,12,14,12">
                <Border Background="#181B24" BorderBrush="#262B38" BorderThickness="1" CornerRadius="8" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="46" Height="46" Background="#12151E" BorderBrush="#10B981" BorderThickness="1" CornerRadius="8" Margin="0,0,12,0">
                            <Image Source="{Binding FileName, Converter={StaticResource FileIconConverter}}"
                                   Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FileName}" FontSize="13.5" FontWeight="Bold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="SummaryText" FontSize="11.5" Foreground="#34D399" Margin="0,3,0,0"/>
                            <TextBlock Text="{Binding DestinationPath}" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding DestinationPath}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Footer Actions -->
            <Border Grid.Row="2" Background="#181A22" BorderBrush="#262B38" BorderThickness="0,1,0,0" Padding="14,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="OpenFileBtn" Grid.Column="0" Content="Open"
                            Background="#059669" BorderBrush="#10B981" Foreground="#FFFFFF"
                            Style="{StaticResource DoneBtn}" MinWidth="74" Margin="0,0,8,0"
                            Click="OpenFileButton_Click"/>

                    <Button x:Name="OpenWithBtn" Grid.Column="1" Content="Open With"
                            Background="#6366F1" BorderBrush="#818CF8" Foreground="#FFFFFF"
                            Style="{StaticResource DoneBtn}" MinWidth="88" Margin="0,0,8,0"
                            Click="OpenWithButton_Click"/>

                    <Button x:Name="OpenFolderBtn" Grid.Column="2" Content="Open Folder"
                            Background="#0284C7" BorderBrush="#38BDF8" Foreground="#FFFFFF"
                            Style="{StaticResource DoneBtn}" MinWidth="92"
                            Click="OpenFolderButton_Click"/>

                    <Button Grid.Column="4" Content="Close"
                            Style="{StaticResource DoneBtn}" MinWidth="68"
                            Click="CloseButton_Click" IsDefault="True" IsCancel="True"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
