<Window x:Class="NovaDownloader.UI.Dialogs.SchedulerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NovaDownloader Scheduler &amp; Queues"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="780" Height="510" MinWidth="680" MinHeight="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#14161D" Foreground="#F1F5F9" FontFamily="Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="SchedInput" TargetType="TextBox">
            <Setter Property="Background" Value="#1B1E28"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="CaretBrush" Value="#22D3EE"/>
            <Setter Property="BorderBrush" Value="#2E3342"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SchedBtn" TargetType="Button">
            <Setter Property="Background" Value="#242836"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#353A4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#1B1F2A"/>
                                <Setter Property="Foreground" Value="#5A657A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SchedPrimaryBtn" TargetType="Button" BasedOn="{StaticResource SchedBtn}">
            <Setter Property="Background" Value="#0891B2"/>
            <Setter Property="BorderBrush" Value="#22D3EE"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#2B2E3B" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" Background="#14161D">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                    <Image Source="pack://application:,,,/Assets/Icons/tb_scheduler.png" Width="16" Height="16" Margin="0,0,8,0"/>
                    <TextBlock Text="Download Scheduler &amp; Named Queues" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Click="Close_Click" Style="{StaticResource CloseCaptionButtonStyle}" Height="30" Width="36"/>
            </Grid>

            <!-- Two-Pane Body -->
            <Grid Grid.Row="1" Margin="14,10,14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="225"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Pane: Named Queues / Schedules -->
                <Border Grid.Column="0" Background="#181B24" BorderBrush="#262B38" BorderThickness="1" CornerRadius="7" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Schedules / Queues" FontSize="12.5" FontWeight="SemiBold" Foreground="#F1F5F9" Margin="0,0,0,8"/>

                        <ListBox x:Name="QueuesListBox" Grid.Row="1" Background="#13161E" BorderBrush="#262B38" BorderThickness="1"
                                 Foreground="#E2E8F0" SelectionChanged="QueuesListBox_SelectionChanged" Margin="0,0,0,8"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="8,7"/>
                                    <Setter Property="Margin" Value="2"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#222736"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#1E3A5F"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding StatusLabel}" FontSize="10.5" Foreground="#22D3EE" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="{Binding ScheduleSummary}" FontSize="10.5" Foreground="#94A3B8" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Inline Create/Rename Box -->
                        <Grid x:Name="QueueNameEditPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="QueueNameInputBox" Grid.Column="0" Style="{StaticResource SchedInput}" Height="26"
                                     KeyDown="QueueNameInputBox_KeyDown" ToolTip="e.g. Games"/>
                            <Button Grid.Column="1" Content="OK" Style="{StaticResource SchedPrimaryBtn}" Height="26" Padding="8,2" Margin="4,0,0,0" Click="ConfirmQueueName_Click"/>
                            <Button Grid.Column="2" Content="✕" Style="{StaticResource SchedBtn}" Height="26" Padding="6,2" Margin="3,0,0,0" Click="CancelQueueName_Click"/>
                        </Grid>

                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="+ New" Style="{StaticResource SchedPrimaryBtn}" Padding="6,5" Margin="0,0,4,0" Click="NewQueue_Click"/>
                            <Button x:Name="RenameQueueBtn" Grid.Column="1" Content="Rename" Style="{StaticResource SchedBtn}" Padding="6,5" Margin="0,0,4,0" Click="RenameQueue_Click"/>
                            <Button x:Name="DeleteQueueBtn" Grid.Column="2" Content="Delete" Style="{StaticResource SchedBtn}" Padding="6,5" Click="DeleteQueue_Click"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Right Pane: Schedule Settings & Assigned Files -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Schedule Timing & Concurrency -->
                    <Border Grid.Row="0" Background="#181B24" BorderBrush="#262B38" BorderThickness="1" CornerRadius="7" Padding="12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="EnableScheduleCheckBox" Grid.Column="0" Content="Enable automatic schedule for this queue"
                                          Foreground="#F1F5F9" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                          Checked="ScheduleOptionChanged" Unchecked="ScheduleOptionChanged"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Files at once:" Foreground="#94A3B8" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="ConcurrencyComboBox" Width="58" Height="27"/>
                                </StackPanel>
                            </Grid>

                            <Grid x:Name="ScheduleTimeGrid">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Frequency" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton x:Name="FreqDailyRadio" Content="Daily" Foreground="#E2E8F0" Margin="0,0,14,0" Checked="FrequencyChanged"/>
                                    <RadioButton x:Name="FreqOneTimeRadio" Content="One-Time" Foreground="#E2E8F0" Margin="0,0,14,0" Checked="FrequencyChanged"/>
                                    <RadioButton x:Name="FreqDaysRadio" Content="Selected Days" Foreground="#E2E8F0" Checked="FrequencyChanged"/>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Start Time" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox x:Name="StartTimeBox" Style="{StaticResource SchedInput}" Width="68" Height="26" Text="02:00" ToolTip="24-hour format HH:mm"/>
                                    <CheckBox x:Name="HasStopTimeCheckBox" Content="Stop at:" Foreground="#94A3B8" FontSize="12" Margin="16,0,6,0" VerticalAlignment="Center"
                                              Checked="ScheduleOptionChanged" Unchecked="ScheduleOptionChanged"/>
                                    <TextBox x:Name="StopTimeBox" Style="{StaticResource SchedInput}" Width="68" Height="26" Text="07:00" ToolTip="24-hour format HH:mm"/>
                                </StackPanel>

                                <!-- OneTime Date Row -->
                                <StackPanel x:Name="OneTimeDateRow" Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed" Margin="0,4,0,0">
                                    <TextBlock Text="Date (YYYY-MM-DD):" Foreground="#94A3B8" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox x:Name="OneTimeDateBox" Style="{StaticResource SchedInput}" Width="100" Height="25"/>
                                    <Button Content="Today" Style="{StaticResource SchedBtn}" Height="25" Padding="8,2" Margin="6,0,0,0" Click="SetToday_Click"/>
                                    <Button Content="Tomorrow" Style="{StaticResource SchedBtn}" Height="25" Padding="8,2" Margin="4,0,0,0" Click="SetTomorrow_Click"/>
                                </StackPanel>

                                <!-- Days of Week Row -->
                                <WrapPanel x:Name="DaysOfWeekRow" Grid.Row="2" Grid.Column="1" Visibility="Collapsed" Margin="0,6,0,0">
                                    <CheckBox x:Name="DayMon" Content="Mon" Foreground="#CBD5E1" Margin="0,0,10,0"/>
                                    <CheckBox x:Name="DayTue" Content="Tue" Foreground="#CBD5E1" Margin="0,0,10,0"/>
                                    <CheckBox x:Name="DayWed" Content="Wed" Foreground="#CBD5E1" Margin="0,0,10,0"/>
                                    <CheckBox x:Name="DayThu" Content="Thu" Foreground="#CBD5E1" Margin="0,0,10,0"/>
                                    <CheckBox x:Name="DayFri" Content="Fri" Foreground="#CBD5E1" Margin="0,0,10,0"/>
                                    <CheckBox x:Name="DaySat" Content="Sat" Foreground="#CBD5E1" Margin="0,0,10,0"/>
                                    <CheckBox x:Name="DaySun" Content="Sun" Foreground="#CBD5E1"/>
                                </WrapPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Files in this Schedule -->
                    <Border Grid.Row="2" Background="#181B24" BorderBrush="#262B38" BorderThickness="1" CornerRadius="7" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="FilesHeaderText" Grid.Column="0" Text="Pending files" FontSize="12.5" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                                <Button x:Name="AddHighlightedBtn" Grid.Column="1" Content="+ Add Highlighted" Style="{StaticResource SchedPrimaryBtn}"
                                        Padding="8,4" FontSize="11" Margin="0,0,6,0" Visibility="Collapsed" Click="AddHighlightedToQueue_Click"
                                        ToolTip="Move the items you highlighted in the main list into this schedule"/>
                                <Button x:Name="AssignFromOtherBtn" Grid.Column="2" Content="+ Add Unfinished" Style="{StaticResource SchedBtn}"
                                        Padding="8,4" FontSize="11" Margin="0,0,6,0" Click="AddUnfinishedToQueue_Click"
                                        ToolTip="Assign all unfinished/paused downloads from other queues into this schedule"/>
                                <Button Grid.Column="3" Content="Remove" Style="{StaticResource SchedBtn}"
                                        Padding="8,4" FontSize="11" Click="RemoveSelectedFromQueue_Click"
                                        ToolTip="Move selected file(s) back to Main Queue"/>
                            </Grid>

                            <ListBox x:Name="QueueFilesListBox" Grid.Row="1" SelectionMode="Extended"
                                     Background="#13161E" BorderBrush="#262B38" BorderThickness="1" Foreground="#E2E8F0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="75"/>
                                                <ColumnDefinition Width="76"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="#F1F5F9" ToolTip="{Binding FileName}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding FormattedTotalBytes}" FontSize="11.5" Foreground="#94A3B8" HorizontalAlignment="Right" Margin="8,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="11.5" Foreground="#22D3EE" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#181A22" BorderBrush="#262B38" BorderThickness="0,1,0,0" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="▶ Start Queue Now"
                            Background="#059669" BorderBrush="#10B981" Foreground="#FFFFFF"
                            Style="{StaticResource SchedBtn}" Margin="0,0,8,0" Click="StartQueueNow_Click"/>

                    <Button Grid.Column="1" Content="■ Stop Queue"
                            Background="#B45309" BorderBrush="#F59E0B" Foreground="#FFFFFF"
                            Style="{StaticResource SchedBtn}" Click="StopQueueNow_Click"/>

                    <Button Grid.Column="3" Content="Save &amp; Close" Style="{StaticResource SchedPrimaryBtn}"
                            MinWidth="110" Click="SaveAndClose_Click" IsDefault="True"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
