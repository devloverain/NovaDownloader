<Window x:Class="NovaDownloader.UI.Dialogs.DeleteConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remove Download(s)"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="445" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#14161D" Foreground="#F1F5F9" FontFamily="Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="DelBtn" TargetType="Button">
            <Setter Property="Background" Value="#242836"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#353B4E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#353A4A" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" Background="#14161D">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                    <Image Source="pack://application:,,,/Assets/Icons/tb_delete.png" Width="15" Height="15"
                           RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,7,0"/>
                    <TextBlock Text="Confirm Delete" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Click="CancelButton_Click" Style="{StaticResource CloseCaptionButtonStyle}" Height="30" Width="36"/>
            </Grid>

            <!-- Body -->
            <StackPanel Grid.Row="1" Margin="16,12,16,14">
                <TextBlock x:Name="HeaderMessage" Text="Remove selected download(s)?" FontSize="13.5" FontWeight="Bold"
                           Foreground="#F8FAFC" TextWrapping="Wrap" Margin="0,0,0,8"/>

                <Border Background="#181B24" BorderBrush="#262B38" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                    <ItemsControl x:Name="FileNamesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="11.5" Foreground="#CBD5E1" TextTrimming="CharacterEllipsis" Margin="0,1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <TextBlock x:Name="MissingHintText" Visibility="Collapsed" FontSize="11" Foreground="#FBBF24" TextWrapping="Wrap" Margin="0,0,0,2"/>
                <TextBlock Text="Choose whether to remove only from NovaDownloader's list or also delete the file(s) from disk."
                           FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- 3-Button Footer -->
            <Border Grid.Row="2" Background="#181A22" BorderBrush="#262B38" BorderThickness="0,1,0,0" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Delete from List"
                            Background="#0891B2" BorderBrush="#22D3EE" Foreground="#FFFFFF"
                            Style="{StaticResource DelBtn}" MinWidth="116" Margin="0,0,8,0"
                            Click="DeleteFromListButton_Click" IsDefault="True"/>

                    <Button x:Name="DeleteFileBtn" Grid.Column="1" Content="Delete File &amp; List"
                            Background="#B91C1C" BorderBrush="#EF4444" Foreground="#FFFFFF"
                            Style="{StaticResource DelBtn}" MinWidth="124"
                            Click="DeleteFileAndListButton_Click"/>

                    <Button Grid.Column="3" Content="Cancel"
                            Style="{StaticResource DelBtn}" MinWidth="74"
                            Click="CancelButton_Click" IsCancel="True"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
