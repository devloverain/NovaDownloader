<Window x:Class="NovaDownloader.UI.Dialogs.DownloadProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:NovaDownloader.UI.Controls"
        Title="Downloading"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#14161D" Foreground="#F1F5F9" FontFamily="Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#242836"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#353B4E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#1B1F2A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#282D3B"/>
                                <Setter Property="Foreground" Value="#5A657A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MetricVal" TargetType="TextBlock">
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            <Setter Property="Typography.NumeralStyle" Value="Lining"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#2B2E3B" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Compact Title Bar -->
            <Grid Grid.Row="0" Background="#14161D">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="pack://application:,,,/Assets/Icons/app_logo.png" Width="15" Height="15"
                       RenderOptions.BitmapScalingMode="HighQuality" Margin="10,0,7,0" VerticalAlignment="Center"/>

                <Border Grid.Column="1" Background="#162436" BorderBrush="#22D3EE" BorderThickness="1" CornerRadius="4"
                        Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderPercentText" Text="0.0%" FontSize="10.5" FontWeight="Bold" Foreground="#22D3EE"
                               Typography.NumeralAlignment="Tabular" Typography.NumeralStyle="Lining"/>
                </Border>

                <TextBlock Grid.Column="2" x:Name="HeaderTitleText" Text="Downloading..." FontSize="12" FontWeight="SemiBold"
                           Foreground="#E2E8F0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>

                <Button Grid.Column="3" Content="✕" Click="CloseButton_Click" Style="{StaticResource CloseCaptionButtonStyle}" Height="30" Width="36" ToolTip="Hide Window"/>
            </Grid>

            <!-- Body -->
            <StackPanel Grid.Row="1" Margin="14,10,14,12">
                <TextBlock Text="{Binding FileName}" FontSize="13.5" FontWeight="Bold" Foreground="#F8FAFC"
                           TextTrimming="CharacterEllipsis" Margin="0,0,0,2"/>
                <TextBlock Text="{Binding Url}" FontSize="11" Foreground="#64748B"
                           TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>

                <!-- Compact 4-Metric Strip -->
                <Border Background="#181B24" BorderBrush="#262B38" BorderThickness="1" CornerRadius="7" Padding="10,8" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition Width="0.85*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Speed" Foreground="#64748B" FontSize="10.5"/>
                            <TextBlock Text="{Binding FormattedSpeed}" Foreground="#38BDF8" Style="{StaticResource MetricVal}" Margin="0,1,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Transferred" Foreground="#64748B" FontSize="10.5"/>
                            <TextBlock Style="{StaticResource MetricVal}" Margin="0,1,0,0">
                                <Run Text="{Binding FormattedDownloadedBytes, Mode=OneWay}"/><Run Text=" / " Foreground="#64748B"/><Run Text="{Binding FormattedTotalBytes, Mode=OneWay}" Foreground="#94A3B8"/>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Time Left" Foreground="#64748B" FontSize="10.5"/>
                            <TextBlock Text="{Binding FormattedRemainingTime}" Style="{StaticResource MetricVal}" Margin="0,1,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Status" Foreground="#64748B" FontSize="10.5"/>
                            <TextBlock Text="{Binding Status}" Foreground="#22D3EE" Style="{StaticResource MetricVal}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Smooth Physics Progress Bar -->
                <controls:FluidProgressBar Height="22"
                                           Value="{Binding ProgressPercentage, Mode=OneWay}"
                                           Status="{Binding Status, Mode=OneWay}"
                                           FontSize="11"
                                           ShowText="True"/>

                <!-- Error Banner -->
                <TextBlock x:Name="ErrorBanner" Text="{Binding ErrorMessage}" Foreground="#F87171" FontSize="11"
                           Margin="2,6,2,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding ErrorMessage}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <!-- Compact Footer -->
            <Border Grid.Row="2" Background="#181A22" BorderBrush="#262B38" BorderThickness="0,1,0,0" Padding="14,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="PauseResumeBtn" Grid.Column="0" Content="Pause"
                            Background="#D97706" BorderBrush="#F59E0B" Foreground="#FFFFFF"
                            Style="{StaticResource ActionBtn}" MinWidth="82" Margin="0,0,8,0"
                            Click="PauseResumeButton_Click"/>

                    <Button x:Name="OpenFolderBtn" Grid.Column="1" Content="Folder"
                            Background="#0284C7" BorderBrush="#38BDF8" Foreground="#FFFFFF"
                            Style="{StaticResource ActionBtn}" MinWidth="70"
                            Click="OpenFolderButton_Click" ToolTip="Open output folder"/>

                    <Button x:Name="CancelBtn" Grid.Column="3" Content="Cancel"
                            Style="{StaticResource ActionBtn}" MinWidth="72" Margin="0,0,8,0"
                            Click="CancelButton_Click"/>

                    <Button Grid.Column="4" Content="Hide"
                            Style="{StaticResource ActionBtn}" MinWidth="66"
                            Click="CloseButton_Click" ToolTip="Continue downloading in background"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
