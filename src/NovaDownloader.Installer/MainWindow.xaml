<Window x:Class="NovaDownloader.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NovaDownloader Setup"
        Icon="pack://application:,,,/app.ico"
        Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#14161D" Foreground="#F1F5F9" FontFamily="Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="SecBtn" TargetType="Button">
            <Setter Property="Background" Value="#242836"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#353B4E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimBtn" TargetType="Button" BasedOn="{StaticResource SecBtn}">
            <Setter Property="Background" Value="#0891B2"/>
            <Setter Property="BorderBrush" Value="#22D3EE"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#2B2E3B" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" Background="#14161D">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                    <Image Source="pack://application:,,,/app_logo.png" Width="16" Height="16" Margin="0,0,8,0"/>
                    <TextBlock Text="NovaDownloader Installer (v1.2.1)" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Width="38" Height="32" Background="Transparent" Foreground="#CBD5E1"
                        BorderThickness="0" Click="Cancel_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>

            <!-- Body -->
            <StackPanel Grid.Row="1" Margin="18,14,18,14">
                <TextBlock Text="Install NovaDownloader" FontSize="17" FontWeight="Bold" Foreground="#F8FAFC"/>
                <TextBlock Text="Multi-Segment Download Manager, Media Stream Grabber &amp; Scheduler"
                           FontSize="12" Foreground="#94A3B8" Margin="0,3,0,14"/>

                <Border Background="#181B24" BorderBrush="#262B38" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Install Location:" FontSize="11.5" Foreground="#94A3B8" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="InstallPathBox" Grid.Column="0" Background="#1B1E28" Foreground="#F1F5F9"
                                     BorderBrush="#2E3342" BorderThickness="1" Padding="8,5" FontSize="12"/>
                            <Button Grid.Column="1" Content="Browse..." Style="{StaticResource SecBtn}" Margin="6,0,0,0" Click="Browse_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="#181B24" BorderBrush="#262B38" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox x:Name="DesktopShortcutCheckBox" Content="Create Desktop shortcut" IsChecked="True" Foreground="#E2E8F0" Margin="0,0,0,6"/>
                        <CheckBox x:Name="RegisterHostCheckBox" Content="Register Browser Native Messaging Host (Chrome / Edge / Opera / Brave)" IsChecked="True" Foreground="#E2E8F0" Margin="0,0,0,6"/>
                        <CheckBox x:Name="StartupCheckBox" Content="Launch NovaDownloader on Windows startup (minimized to tray)" IsChecked="True" Foreground="#E2E8F0" Margin="0,0,0,6"/>
                        <CheckBox x:Name="LaunchNowCheckBox" Content="Launch NovaDownloader after installation" IsChecked="True" Foreground="#E2E8F0"/>
                    </StackPanel>
                </Border>

                <ProgressBar x:Name="InstallProgress" Height="10" Minimum="0" Maximum="100" Value="0"
                             Background="#1B1E28" Foreground="#22D3EE" BorderBrush="#262B38" Margin="0,0,0,6"/>
                <TextBlock x:Name="StatusText" Text="Ready to install." FontSize="11.5" Foreground="#94A3B8"/>
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#181A22" BorderBrush="#262B38" BorderThickness="0,1,0,0" Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="InstallBtn" Content="Install" Style="{StaticResource PrimBtn}" MinWidth="110" Margin="0,0,8,0" Click="Install_Click" IsDefault="True"/>
                    <Button x:Name="CancelBtn" Content="Cancel" Style="{StaticResource SecBtn}" MinWidth="80" Click="Cancel_Click" IsCancel="True"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
